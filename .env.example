# GitHub Pages 静态版环境变量（构建时注入前端产物，均为公开值）
# 换成自己的 Supabase 项目时改这里，或在 CI 的 Variables / Secrets 中配置。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# 与 GitHub Pages 仓库名一致；本地用根路径预览时可设为 /
NEXT_PUBLIC_BASE_PATH=/ai-wrong-question-review

# 数据库连接地址（Supabase PostgreSQL）
# 应用运行时使用连接池（Transaction Pooler，端口 6543）；serverless 部署需加 pgbouncer 参数
# 在 Supabase 控制台 → Project Settings → Database → Connection string 获取
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# 迁移专用直连（Session/Direct，端口 5432），仅供 prisma migrate 使用
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# NextAuth 会话加密密钥
# 生产环境必须修改！可以使用 `openssl rand -base64 32` 生成
NEXTAUTH_SECRET="supersecret-dev-secret"

# 首个管理员账号（容器启动时由 seed-admin 创建，仅用于首次初始化）
# 生产环境必须设置强密码。若生产模式未设置，seed-admin 会生成随机密码并打印到启动日志（仅显示一次）。
# 注意：注册默认关闭，首次登录只能用这个账号，登录后请立即修改密码。
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD=""

# 应用的基础 URL
# 本地开发通常是 http://localhost:3000
# 生产环境如果使用 Docker 且 IP 不固定，可保持注释（auth.ts 里已固定会话 cookie 名）
# NEXTAUTH_URL="http://localhost:3000"

# 注：AUTH_TRUST_HOST / trustHost 是 Auth.js v5 的配置，本项目使用 next-auth v4，
# v4 不会读取该变量。代理部署请通过 NEXTAUTH_URL 与反向代理的 Host 头处理。
# AUTH_TRUST_HOST=true

# AI 服务提供商配置
# 可选值: "openai" (推荐，兼容通义千问/智谱/豆包/硅基流动等国内厂商) 或 "gemini"
AI_PROVIDER="openai"

# OpenAI 兼容接口配置（通义千问 VL 示例）
# DashScope 兼容模式地址: https://dashscope.aliyuncs.com/compatible-mode/v1
# 视觉模型: qwen3-vl-plus / qwen-vl-max / qwen2.5-vl-72b-instruct
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
OPENAI_MODEL="qwen3-vl-plus"

# Google Gemini 配置 (当 AI_PROVIDER="gemini" 时需要)
GOOGLE_API_KEY=""
GEMINI_BASE_URL="" # 可选，用于自定义 API 地址
GEMINI_MODEL="gemini-2.5-flash" # 可选，默认为 gemini-2.5-flash

# 日志配置
# 日志级别: trace, debug, info, warn, error, fatal
# 开发环境建议使用 debug，生产环境建议使用 info
LOG_LEVEL="debug"

# Database Debugging
# Set to "true" to enable SQL query logging
DEBUG_DB="false"

# Openclaw Agent API 配置
# 用于对接本地部署的 Openclaw agent 进行错题识别
OPENCLAW_API_URL="http://localhost:8080"  # Openclaw agent 服务地址
OPENCLAW_API_KEY=""  # Openclaw API 密钥
OPENCLAW_TIMEOUT=30000  # 请求超时时间（毫秒），默认30秒

# 本系统 API 认证模式配置
# 可选值: "credentials" (用户名密码登录，默认) 或 "apikey" (API Key认证)
OPENCLAW_AUTH_MODE="credentials"

# 本系统 API 密钥（用于 Openclaw agent 调用本系统）
# 仅当 OPENCLAW_AUTH_MODE=apikey 时需要配置
# 生成方式: openssl rand -hex 32
OPENCLAW_INTEGRATION_API_KEY=""

# apikey 模式下「以谁的身份写入」的服务端绑定账号（必填）
# 集成 Key 是全局凭据，不再允许请求体指定 userEmail；未配置时批量上传接口会直接拒绝。
# 建议专门创建一个服务账号，不要用 admin 邮箱。
OPENCLAW_SERVICE_USER_EMAIL="openclaw@localhost"

# 出站 AI 地址白名单逃生开关（默认 false，强烈建议保持关闭）
# /api/ai/models 与 /api/ai/test 会拒绝内网 / 元数据 / 非 HTTPS 地址。
# 仅当公司内网自建了 AI 网关、且明确知晓 SSRF 风险时才设为 true。
AI_ALLOW_PRIVATE_ENDPOINTS="false"
